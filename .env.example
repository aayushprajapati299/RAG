# ==============================================================================
# Vectorless RAG Application Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Environment mode: development, testing, staging, or production
ENVIRONMENT=development

# Database connection URL
# Local development default with Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db
# Test database URL (used by pytest suite):
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_test_db

# Groq API key for LLM generation (obtain from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Application secret key for session cookies, CSRF protection, and JWT signing
# NOTE: In production, generate a secure random string (min 32 characters)
SECRET_KEY=dev-secret-key-do-not-use-in-production

# Groq LLM model name & generation parameters
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30.0

# Context & History Limits for RAG Prompting
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS=4000
MAX_HISTORY_TURNS=5

# Document Chunking & Hybrid Retrieval Weights
CHUNK_SIZE=500
CHUNK_OVERLAP=50
HYBRID_BM25_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# Optional Tesseract OCR binary path (leave empty to use system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Docker example: /usr/bin/tesseract
TESSERACT_CMD=

# Server Network Settings
HOST=0.0.0.0
PORT=5000
DEBUG=false
